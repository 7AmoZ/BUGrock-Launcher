<Window x:Class="MCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCLauncher.WPFDataTypes"
        mc:Ignorable="d"
        Title="BUGrock Launcher" 
        Height="780" Width="1200"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#0F1015"
        Icon="Assets/bugrock.ico"
        MouseMove="Window_MouseMove">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Exact Color Tokens from HTML -->
        <SolidColorBrush x:Key="BgPrimary" Color="#0F1015"/>
        <SolidColorBrush x:Key="BgSecondary" Color="#13141A"/>
        <SolidColorBrush x:Key="BgCard" Color="#181921"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#21222D"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#232530"/>
        <SolidColorBrush x:Key="BorderElevated" Color="#282A36"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#38A169"/>
        <SolidColorBrush x:Key="AccentGreenHover" Color="#48BB78"/>
        <SolidColorBrush x:Key="AccentGreenDark" Color="#276749"/>
        <SolidColorBrush x:Key="AccentMagenta" Color="#D05CE3"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8E92A4"/>
        <SolidColorBrush x:Key="TextSubtle" Color="#606478"/>
        <SolidColorBrush x:Key="RecessedBg" Color="#0B0C0F"/>

        <!-- Version List Collection Views -->
        <CollectionViewSource x:Key="versionListViewRelease" IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewBeta" IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewPreview" IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewImported" IsLiveFilteringRequested="True"/>

        <!-- Top Navigation Tab RadioButton Style (NO blue highlight, clean green underline) -->
        <Style x:Key="TopNavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E92A4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="2,12,2,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38A169"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub Filter Tab RadioButton Style -->
        <Style x:Key="SubFilterTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E92A4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="2,6,2,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38A169"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Giant PLAY Pixel Button Style -->
        <Style x:Key="GiantPlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#276749" BorderThickness="0,0,0,3" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Effect>
                                    <DropShadowEffect Color="#1E4E38" BlurRadius="2" ShadowDepth="2" Direction="270" Opacity="0.9"/>
                                </ContentPresenter.Effect>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#48BB78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#276749"/>
                                <Setter TargetName="btnBorder" Property="BorderThickness" Value="0,2,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#232530"/>
                                <Setter Property="Foreground" Value="#606478"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Dark Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C1E2A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#323548" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#282B3C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#161722"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Remove Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#13141A"/>
            <Setter Property="Foreground" Value="#8E92A4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#232530" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3B1C1C"/>
                                <Setter Property="Foreground" Value="#FF6B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Cancel Button Style -->
        <Style x:Key="HeroCancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E92A4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E53E3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#C53030"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template for Version Not Installed (Clean Card with Subtle Contrast, Bedrock Block Icon, Gray RELEASE badge, DOWNLOAD button) -->
        <DataTemplate x:Key="templateVersionNotInstalled" DataType="{x:Type local:Version}">
            <Border Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Meaningful & Visible Minecraft Block Icon -->
                    <Border Grid.Column="0" Width="40" Height="40" Background="#14151F" BorderBrush="#35384D" BorderThickness="1.5" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image Source="Assets/bugrock_block.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Border Background="#242636" BorderBrush="#32354A" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="RELEASE" Foreground="#A0A5BD" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Not installed &#x2022; Online Repository" Foreground="#767A92" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button x:Name="DownloadButton" Grid.Column="2" Style="{StaticResource DarkButtonStyle}" Content="&#x21E9; DOWNLOAD" Command="{Binding DownloadCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" MinWidth="124" Height="38" Padding="16,6" FontSize="12" FontWeight="Bold"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for Version Installed (Clean Card with Subtle Contrast, Green accent border, green badge, PLAY + Trash buttons) -->
        <DataTemplate x:Key="templateVersionInstalled" DataType="{x:Type local:Version}">
            <Border Background="#1C1E2A" BorderBrush="#38A169" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Green Block Icon -->
                    <Border Grid.Column="0" Width="40" Height="40" Background="#14151F" BorderBrush="#38A169" BorderThickness="1.5" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image Source="Assets/bugrock_block.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Border Background="#1C2E22" BorderBrush="#38A169" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="RELEASE" Foreground="#38A169" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayInstallStatus}" Foreground="#A0A5BD" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button x:Name="DownloadButton" Grid.Column="2" Style="{StaticResource GiantPlayButtonStyle}" Content="PLAY" Command="{Binding LaunchCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" MinWidth="96" Height="38" Padding="20,6" FontSize="14" FontWeight="Bold" Margin="0,0,10,0"/>
                    <Button x:Name="RemoveButton" Grid.Column="3" Style="{StaticResource DangerButtonStyle}" Content="&#x1F5D1;" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" Width="38" Height="38" Padding="0" FontSize="14" ToolTip="Uninstall this version"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for Version Downloading (Mockup Style: Dynamic Accent border, progress bar, cancel button, download speed indicator) -->
        <DataTemplate x:Key="templateVersionDownloading" DataType="{x:Type local:Version}">
            <Border Background="#1C1E2A" BorderBrush="{Binding StateChangeInfo.StateAccentBrush}" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Version Block Icon with dynamic accent border -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="40" Height="40" Background="#14151F" BorderBrush="{Binding StateChangeInfo.StateAccentBrush}" BorderThickness="1.5" CornerRadius="8" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Image Source="Assets/bugrock_block.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    
                    <!-- Row 0: Version Title & Type Badge -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="{Binding StateChangeInfo.StateBadgeBackgroundBrush}" BorderBrush="{Binding StateChangeInfo.StateAccentBrush}" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayVersionType}" Foreground="{Binding StateChangeInfo.StateAccentBrush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="2" Content="&#x2715;" Width="28" Height="28" Style="{StaticResource DangerButtonStyle}" Padding="0" VerticalAlignment="Center" Command="{Binding StateChangeInfo.CancelCommand}" IsEnabled="{Binding StateChangeInfo.HasCancelCommand}" ToolTip="Cancel download"/>

                    <!-- Row 1: Status on Left, Download Speed on Right (Directly Above Progress Bar) -->
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,4">
                        <TextBlock Text="{Binding StateChangeInfo.DisplayStatus}" Foreground="{Binding StateChangeInfo.StateAccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                        <!-- Speed Badge (e.g. ⚡ 14.8 MB/s) -->
                        <Border Visibility="{Binding StateChangeInfo.SpeedVisibility}" Background="#2B1530" BorderBrush="#D05CE3" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ " Foreground="#D05CE3" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StateChangeInfo.DownloadSpeedText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Thin Progress Bar (4px) with dynamic Accent (Green for extracting/staging) -->
                    <Canvas Name="progressSizeHack" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="4" Margin="0,4,0,0">
                        <ProgressBar Width="{Binding Path=ActualWidth, ElementName=progressSizeHack, Mode=OneWay}" Height="{Binding Path=ActualHeight, ElementName=progressSizeHack, Mode=OneWay}" Minimum="0" Maximum="{Binding StateChangeInfo.MaxProgress}" Value="{Binding StateChangeInfo.Progress}" IsIndeterminate="{Binding StateChangeInfo.IsProgressIndeterminate}" Foreground="{Binding StateChangeInfo.StateAccentBrush}" Background="#12131A" BorderThickness="0"/>
                    </Canvas>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Version List Template -->
        <ControlTemplate x:Key="templateVersionList" TargetType="ContentControl">
            <ListBox ItemsSource="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl x:Name="control" Content="{Binding}" ContentTemplate="{StaticResource templateVersionNotInstalled}"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter TargetName="control" Property="ContentTemplate" Value="{StaticResource templateVersionInstalled}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStateChanging}" Value="True">
                                <Setter TargetName="control" Property="ContentTemplate" Value="{StaticResource templateVersionDownloading}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ControlTemplate>
    </Window.Resources>

    <Grid Background="#0F1015">
        <Grid.RowDefinitions>
            <!-- 1. Top Bar (38px) -->
            <RowDefinition Height="38"/>
            <!-- 2. Middle Body: Sidebar + Main Content -->
            <RowDefinition Height="*"/>
            <!-- 3. Bottom Status Bar (30px) -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 1. TOP MENU BAR (38px)                                         -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="#13141A" BorderBrush="#232530" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,18,0">
                    <Border Width="20" Height="20" CornerRadius="3" Background="#181921" BorderBrush="#282A36" BorderThickness="1" Margin="0,0,8,0">
                        <Image Source="Assets/bugrock_block.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="BUGrock Launcher" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Menus: File, Tools, Options -->
                <Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Foreground="#8E92A4" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Menu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="#8E92A4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Grid>
                                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Checkmark box for IsCheckable items -->
                                                    <Border x:Name="checkMarkBorder" Grid.Column="0" Width="15" Height="15" CornerRadius="3" Background="#1C2E22" BorderBrush="#38A169" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                                                        <TextBlock Text="✓" Foreground="#38A169" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                                    </Border>
                                                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Fade">
                                                        <Border Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="6" Padding="4" SnapsToDevicePixels="True">
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                                            </Border.Effect>
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Role" Value="SubmenuItem">
                                                <Setter TargetName="border" Property="Padding" Value="10,6"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="checkMarkBorder" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#252838"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSubmenuOpen" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#252838"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="#606478"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="Separator">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Separator">
                                        <Border Height="1" Background="#2D3042" Margin="4,3"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Menu.Resources>
                    <MenuItem Header="_File">
                        <MenuItem Header="Open log file" Click="MenuItemOpenLogFileClicked" />
                        <MenuItem Header="Open launcher data folder in Explorer" Click="MenuItemOpenDataDirClicked"/>
                        <Separator Background="#232530"/>
                        <MenuItem Header="_Import .appx or .msixvc..." Click="ImportButtonClicked" />
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="Uninstall all versions" Name="CleanupForMicrosoftStoreReinstall" Click="MenuItemUninstallAllVersionsClicked" />
                        <MenuItem Header="Cleanup for installing Minecraft from Microsoft Store" Name="CleanupForMicrosoftStoreInstall" Click="MenuItemCleanupForStoreInstallClicked" />
                        <MenuItem Header="Refresh version list" Name="RefreshVersionList" Click="MenuItemRefreshVersionListClicked" />
                        <MenuItem Header="Find my Minecraft data" Click="MenuItemFindMyDataClicked" />
                    </MenuItem>
                    <MenuItem Header="_Options">
                        <MenuItem Header="Auto-fetch decryption keys for modern versions" IsCheckable="True" Name="AutoFetchDecryptionKeysOption" Checked="AutoFetchDecryptionKeysCheck_Changed" Unchecked="AutoFetchDecryptionKeysCheck_Changed" IsChecked="{Binding UserPrefs.AutoFetchDecryptionKeys}" ToolTip="When enabled, the launcher automatically acquires prerequisite keys in the background to decrypt modern GDK versions seamlessly." />
                        <MenuItem Header="Delete packages (.appx / .msixvc) after extraction" IsCheckable="True" Name="DeleteAppxAfterDownloadOption" Checked="DeleteAppxAfterDownloadCheck_Changed" Unchecked="DeleteAppxAfterDownloadCheck_Changed" IsChecked="{Binding UserPrefs.DeleteAppxAfterDownload}" ToolTip="When checked, downloaded package files are automatically deleted after extraction to save disk space." />
                        <MenuItem Header="Set version data endpoints..." Name="SetVersionListEndpoint" Click="MenuItemSetVersionListEndpointClicked" />
                    </MenuItem>
                </Menu>

                <!-- Right Pill Button & Native Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="ImportButtonClicked" Style="{StaticResource DarkButtonStyle}" Padding="10,4" Margin="0,0,14,0" ToolTip="Import .appx package">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+ " Foreground="#38A169" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Import .appx" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Border Width="1" Height="14" Background="#232530" Margin="0,0,10,0"/>

                    <!-- Minimize Button -->
                    <Button Click="btnMinimize_Click" Width="26" Height="26" Style="{StaticResource DarkButtonStyle}" Background="Transparent" BorderThickness="0" Padding="0" Content="-" FontSize="14" ToolTip="Minimize"/>
                    <!-- Maximize Button -->
                    <Button Click="btnMaximize_Click" Width="26" Height="26" Style="{StaticResource DarkButtonStyle}" Background="Transparent" BorderThickness="0" Padding="0" Content="&#x25A2;" FontSize="12" ToolTip="Maximize"/>
                    <!-- Close Button -->
                    <Button Click="btnClose_Click" Width="26" Height="26" Style="{StaticResource DangerButtonStyle}" Background="Transparent" BorderThickness="0" Padding="0" Content="&#x2715;" FontSize="11" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 2. MAIN MIDDLE BODY (Sidebar + Views)                          -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar (240px) -->
                <ColumnDefinition Width="240"/>
                <!-- Main Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#13141A" BorderBrush="#232530" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Main Sidebar Content (Skin Manager) -->
                        <RowDefinition Height="*"/>
                        <!-- Local Data Directory Footer Link -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Center: 3D Skin Manager -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,14,14,0">
                            <!-- SKIN MANAGER Card with 3D Head Widget -->
                            <Border Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Header -->
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="SKIN MANAGER" Foreground="#8E92A4" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="&#x26F6;" HorizontalAlignment="Right" Foreground="#606478" FontSize="11"/>
                                    </Grid>

                                    <!-- Skin Name Status -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Ellipse Width="6" Height="6" Fill="#D05CE3" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="SkinNameLabel" Text="BUGrock (Glitched)" Foreground="#D05CE3" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <!-- 3D Interactive Head Viewport -->
                                    <Border Height="140" Background="#0B0C0F" CornerRadius="6" BorderBrush="#1C1D24" BorderThickness="1" Margin="0,0,0,10" ClipToBounds="True">
                                        <Grid>
                                            <Viewport3D x:Name="HeadViewport">
                                                <Viewport3D.Camera>
                                                    <PerspectiveCamera Position="0, 0, 2.85" LookDirection="0, 0, -1" UpDirection="0, 1, 0" FieldOfView="45"/>
                                                </Viewport3D.Camera>
                                                
                                                <ModelVisual3D>
                                                    <ModelVisual3D.Content>
                                                        <Model3DGroup>
                                                            <AmbientLight Color="#999999"/>
                                                            <DirectionalLight Color="#FFFFFF" Direction="-1, -1.5, -2"/>
                                                            
                                                            <Model3DGroup x:Name="HeadModelGroup">
                                                                <Model3DGroup.Transform>
                                                                    <Transform3DGroup>
                                                                        <RotateTransform3D>
                                                                            <RotateTransform3D.Rotation>
                                                                                <AxisAngleRotation3D x:Name="SteveHeadRotationYaw" Axis="0,1,0" Angle="0"/>
                                                                            </RotateTransform3D.Rotation>
                                                                        </RotateTransform3D>
                                                                        <RotateTransform3D>
                                                                            <RotateTransform3D.Rotation>
                                                                                <AxisAngleRotation3D x:Name="SteveHeadRotationPitch" Axis="1,0,0" Angle="0"/>
                                                                            </RotateTransform3D.Rotation>
                                                                        </RotateTransform3D>
                                                                    </Transform3DGroup>
                                                                </Model3DGroup.Transform>
                                                            </Model3DGroup>
                                                        </Model3DGroup>
                                                    </ModelVisual3D.Content>
                                                </ModelVisual3D>
                                            </Viewport3D>
                                        </Grid>
                                    </Border>

                                    <!-- Preset Selector Pills with Selection Rings -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <!-- Custom Skin Dot (Green) -->
                                        <Button x:Name="PresetCustomBtn" Click="PresetCustom_Click" Width="26" Height="26" Margin="0,0,10,0" Cursor="Hand" ToolTip="My Custom Skin" Background="Transparent" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Border x:Name="PresetCustomRing" Width="24" Height="24" CornerRadius="12" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse Width="14" Height="14" Fill="#38A169" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <!-- Default Missing Texture Glitched Skin Dot (Purple) -->
                                        <Button x:Name="PresetGlitchedBtn" Click="PresetGlitched_Click" Width="26" Height="26" Cursor="Hand" ToolTip="Default BUGrock Glitched Skin" Background="Transparent" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Border x:Name="PresetGlitchedRing" Width="24" Height="24" CornerRadius="12" BorderBrush="#D05CE3" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse Width="14" Height="14" Fill="#D05CE3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>

                                    <!-- Upload Skin Button -->
                                    <Button Click="UploadSkinButton_Click" Style="{StaticResource DarkButtonStyle}" Padding="10,7" HorizontalAlignment="Stretch" ToolTip="Upload custom 64x64 Minecraft skin (.png)">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="+ " FontWeight="Bold" Foreground="#38A169" FontSize="12"/>
                                            <TextBlock Text="UPLOAD SKIN (.PNG)" FontSize="10" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Local Data Directory Link -->
                    <Border Grid.Row="2" BorderBrush="#232530" BorderThickness="0,1,0,0" Padding="14,10">
                        <Button Click="MenuItemOpenDataDirClicked" Style="{StaticResource DarkButtonStyle}" Background="Transparent" BorderThickness="0" Padding="4,4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C1;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Local Data Directory" Foreground="#8E92A4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Top Navigation Tabs (Play | Installations | Patch Notes) -->
                    <RowDefinition Height="46"/>
                    <!-- Active Tab View -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Navigation Tabs -->
                <Border Grid.Row="0" Background="#13141A" BorderBrush="#232530" BorderThickness="0,0,0,1" Padding="24,0,24,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="TabNavPlay" Content="Play" IsChecked="True" Checked="TabNav_Checked" GroupName="MainViews" Style="{StaticResource TopNavTabStyle}"/>
                            <RadioButton x:Name="TabNavInstallations" Content="Installations" Checked="TabNav_Checked" GroupName="MainViews" Style="{StaticResource TopNavTabStyle}"/>
                            <RadioButton x:Name="TabNavPatchNotes" Content="Patch Notes" Checked="TabNav_Checked" GroupName="MainViews" Style="{StaticResource TopNavTabStyle}"/>
                        </StackPanel>

                        <!-- Right Architecture Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Architecture: " Foreground="#606478" FontSize="11"/>
                                <TextBlock Text="x64 UWP Bridge" Foreground="#8E92A4" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- VIEW 1: PLAY VIEW -->
                <Grid x:Name="PlayViewGrid" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Hero Section (330px) -->
                        <RowDefinition Height="330"/>
                        <!-- News Cards -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hero Art Landscape -->
                    <Grid Grid.Row="0" Margin="16,14,16,8">
                        <Border CornerRadius="8" ClipToBounds="True" BorderBrush="#232530" BorderThickness="1">
                            <Grid>
                                <!-- Clean Sunset Minecraft Voxel Wallpaper -->
                                <Image Source="Assets/launcher_hero.png" Stretch="UniformToFill" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                <!-- Smooth Gradient Shadow Overlay at bottom of hero -->
                                <Grid>
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#000F1015" Offset="0.3"/>
                                            <GradientStop Color="#B30F1015" Offset="0.75"/>
                                            <GradientStop Color="#E60F1015" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                </Grid>

                                <!-- Integrated BUGrock Launcher 3D Stone Title Logo -->
                                <Image Source="Assets/bugrock_logo.png" 
                                       Height="210" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Top" 
                                       Margin="0,10,0,0"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.65"/>
                                    </Image.Effect>
                                </Image>

                                <!-- Hero Bottom Controls (Version Box & Giant PLAY Button) -->
                                <Grid VerticalAlignment="Bottom" Margin="20,0,20,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Version Selector Box (Clickable Dropdown) -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Border x:Name="SelectedVersionBox" Cursor="Hand" PreviewMouseLeftButtonDown="SelectedVersionBox_PreviewMouseDown" PreviewMouseLeftButtonUp="SelectedVersionBox_PreviewMouseUp" CornerRadius="6" Padding="14,10" MinWidth="220" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1C1E2A"/>
                                                    <Setter Property="BorderBrush" Value="#2D3042"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#252839"/>
                                                            <Setter Property="BorderBrush" Value="#38A169"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="SELECTED VERSION" Foreground="#8E92A4" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="QuickPlayVersionLabel" Text="Select Version" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="&#x25BE;" Foreground="#38A169" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Popup x:Name="VersionSelectorPopup" PlacementTarget="{Binding ElementName=SelectedVersionBox}" Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#161722" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="8" Padding="8" MinWidth="260" MaxWidth="380" MaxHeight="320">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.6"/>
                                                </Border.Effect>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="VersionSelectorItemsPanel"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <!-- Middle Hero Progress Card (Update / Downgrade / Extraction / Launching) -->
                                    <Border x:Name="HeroProgressContainer" Grid.Column="1" Visibility="Collapsed" Margin="14,0,14,0" Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="6" Padding="14,8" VerticalAlignment="Center" Height="52">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.4"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Top Row: Action Badge + Status Text -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,6">
                                                <Border x:Name="HeroStatusBadge" Background="#1C2E22" BorderBrush="#38A169" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="HeroStatusAction" Text="UPDATING" Foreground="#38A169" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock x:Name="HeroStatusDetail" Text="Preparing..." Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Cancel Button (✕) -->
                                            <Button x:Name="HeroCancelButton" Grid.Row="0" Grid.Column="1" Click="HeroCancelButton_Click" Style="{StaticResource HeroCancelButtonStyle}" ToolTip="Cancel operation" VerticalAlignment="Center" Margin="0,0,0,6">
                                                <TextBlock Text="&#x2715;" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>

                                            <!-- Bottom Row: Green Progress Bar -->
                                            <Canvas x:Name="HeroProgressSizeHack" Grid.Row="1" Grid.ColumnSpan="2" Height="4">
                                                <ProgressBar x:Name="HeroProgressBar" Width="{Binding Path=ActualWidth, ElementName=HeroProgressSizeHack, Mode=OneWay}" Height="{Binding Path=ActualHeight, ElementName=HeroProgressSizeHack, Mode=OneWay}" Minimum="0" Maximum="100" Value="0" Foreground="#38A169" Background="#12131A" BorderThickness="0"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <!-- Giant Green Pixel PLAY Button -->
                                    <Button x:Name="QuickPlayButton" Grid.Column="2" Click="QuickPlayButton_Click" Style="{StaticResource GiantPlayButtonStyle}" Content="PLAY" Width="170" Height="54" VerticalAlignment="Center">
                                        <Button.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.4"/>
                                        </Button.Effect>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- News & Community Highlights (3 Cards matching the exact HTML) -->
                    <Grid Grid.Row="1" Margin="16,8,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: What's new in 1.21? -->
                        <Border Grid.Column="0" Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Border Height="110" CornerRadius="6" Margin="0,0,0,10" ClipToBounds="True">
                                    <Image Source="Assets/news_update.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <Grid Margin="0,0,0,4">
                                    <Border HorizontalAlignment="Left" Background="#1C2E22" BorderBrush="#38A169" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="NEWS" Foreground="#38A169" FontWeight="Bold" FontSize="10"/>
                                    </Border>
                                    <TextBlock Text="1.21 Tricky Trials" HorizontalAlignment="Right" Foreground="#606478" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="What's new in 1.21?" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,2,0,4"/>
                                <TextBlock Text="Discover the latest mobs, blocks, and technical changes in the Bedrock ecosystem." Foreground="#8E92A4" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Manage Your Realm -->
                        <Border Grid.Column="2" Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Border Height="110" CornerRadius="6" Margin="0,0,0,10" ClipToBounds="True">
                                    <Image Source="Assets/news_realms.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <Grid Margin="0,0,0,4">
                                    <Border HorizontalAlignment="Left" Background="#2B1530" BorderBrush="#D05CE3" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="REALMS" Foreground="#D05CE3" FontWeight="Bold" FontSize="10"/>
                                    </Border>
                                    <TextBlock Text="Cloud Servers" HorizontalAlignment="Right" Foreground="#606478" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Manage Your Realm" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,2,0,4"/>
                                <TextBlock Text="Connect with friends on a dedicated server. Always online, always available." Foreground="#8E92A4" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Explore Marketplace -->
                        <Border Grid.Column="4" Background="#1C1E2A" BorderBrush="#2D3042" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Border Height="110" CornerRadius="6" Margin="0,0,0,10" ClipToBounds="True">
                                    <Image Source="Assets/news_addons.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <Grid Margin="0,0,0,4">
                                    <Border HorizontalAlignment="Left" Background="#1C2E22" BorderBrush="#38A169" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="ADD-ONS" Foreground="#38A169" FontWeight="Bold" FontSize="10"/>
                                    </Border>
                                    <TextBlock Text="Community Packs" HorizontalAlignment="Right" Foreground="#606478" FontSize="10" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Explore Marketplace" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,2,0,4"/>
                                <TextBlock Text="Find thousands of skins, worlds, and textures created by the community." Foreground="#8E92A4" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- VIEW 2: INSTALLATIONS VIEW -->
                <Grid x:Name="InstallationsViewGrid" Grid.Row="1" Visibility="Collapsed" Margin="24,16,24,10">
                    <Grid.RowDefinitions>
                        <!-- Filter Sub-nav Row -->
                        <RowDefinition Height="Auto"/>
                        <!-- Version Lists -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Sub-nav Row: All | Release | Preview | Beta | Imported + Installed only + Import button -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Filter Pills -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="SubFilterAll" Content="All" IsChecked="True" Checked="SubFilter_Checked" GroupName="SubVersionFilter" Style="{StaticResource SubFilterTabStyle}"/>
                            <RadioButton x:Name="SubFilterRelease" Content="Release" Checked="SubFilter_Checked" GroupName="SubVersionFilter" Style="{StaticResource SubFilterTabStyle}"/>
                            <RadioButton x:Name="SubFilterPreview" Content="Preview" Checked="SubFilter_Checked" GroupName="SubVersionFilter" Style="{StaticResource SubFilterTabStyle}"/>
                            <RadioButton x:Name="SubFilterBeta" Content="Beta" Checked="SubFilter_Checked" GroupName="SubVersionFilter" Style="{StaticResource SubFilterTabStyle}"/>
                            <RadioButton x:Name="SubFilterImported" Content="Imported" Checked="SubFilter_Checked" GroupName="SubVersionFilter" Style="{StaticResource SubFilterTabStyle}"/>
                        </StackPanel>

                        <!-- Right Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Name="ShowInstalledVersionsOnlyCheckbox" Content="Installed only" Checked="ShowInstalledVersionsOnlyCheckbox_Changed" Unchecked="ShowInstalledVersionsOnlyCheckbox_Changed" IsChecked="{Binding UserPrefs.ShowInstalledOnly}" Foreground="#8E92A4" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <Button Content="+ Import .appx" Click="ImportButtonClicked" Style="{StaticResource DarkButtonStyle}" Padding="12,6" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Actual Version Tabs (Under the hood, switching via subfilters) -->
                    <TabControl x:Name="VersionTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Style>
                        </TabControl.ItemContainerStyle>

                        <TabItem Header="Release" x:Name="ReleaseTab">
                            <ContentControl x:Name="ReleaseVersionList" d:DataContext="{d:DesignData /SampleData/Versions.xaml}" Template="{StaticResource templateVersionList}"/>
                        </TabItem>
                        <TabItem Header="Beta" x:Name="BetaTab" Visibility="Collapsed">
                            <ContentControl x:Name="BetaVersionList" d:DataContext="{d:DesignData /SampleData/Versions.xaml}" Template="{StaticResource templateVersionList}"/>
                        </TabItem>
                        <TabItem Header="Preview" x:Name="PreviewTab">
                            <ContentControl x:Name="PreviewVersionList" d:DataContext="{d:DesignData /SampleData/Versions.xaml}" Template="{StaticResource templateVersionList}"/>
                        </TabItem>
                        <TabItem Header="Imported" x:Name="ImportedTab">
                            <ContentControl x:Name="ImportedVersionList" d:DataContext="{d:DesignData /SampleData/Versions.xaml}" Template="{StaticResource templateVersionList}"/>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- VIEW 3: PATCH NOTES VIEW -->
                <Grid x:Name="PatchNotesViewGrid" Grid.Row="1" Visibility="Collapsed" Margin="28,20,28,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Note 1: Exact spec note -->
                            <Border BorderBrush="#38A169" BorderThickness="3,0,0,0" Padding="18,0,0,0" Margin="0,0,0,26">
                                <StackPanel>
                                    <TextBlock Text="MAY 15, 2024" Foreground="#38A169" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Minecraft Bedrock 1.20.81 Hotfix" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="A new update for Minecraft is available, fixing some crashes and bugs that occurred since the release of 1.20.80." Foreground="#8E92A4" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                        <TextBlock Text="&#x2714;" Foreground="#38A169" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="Fixed several crashes that could occur during gameplay." Foreground="#FFFFFF" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2714;" Foreground="#38A169" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="Fixed a bug where the game could freeze when using certain resource packs." Foreground="#FFFFFF" FontSize="13"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Note 2: 1.21 Preview -->
                            <Border BorderBrush="#232530" BorderThickness="3,0,0,0" Padding="18,0,0,0" Margin="0,0,0,24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="MAY 08, 2024" Foreground="#D05CE3" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <Border Background="#2B1530" BorderBrush="#D05CE3" BorderThickness="1" CornerRadius="4" Padding="4,1">
                                            <TextBlock Text="PREVIEW" Foreground="#D05CE3" FontSize="9" FontWeight="Bold"/>
