<Window x:Class="MCLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCLauncher.WPFDataTypes"
        mc:Ignorable="d"
        Title="BUGrock Launcher" 
        Height="720" Width="1120"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Icon="Assets/bugrock.ico">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#121214"/>
        <SolidColorBrush x:Key="BgCard" Color="#1E1E22"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#26262B"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2D2D33"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9E9EA6"/>
        <SolidColorBrush x:Key="MinecraftGreen" Color="#3C8527"/>
        <SolidColorBrush x:Key="MinecraftGreenHover" Color="#4E9E35"/>
        <SolidColorBrush x:Key="MinecraftGreenPressed" Color="#2E691D"/>

        <!-- Version List Collection Views -->
        <CollectionViewSource x:Key="versionListViewRelease" IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewBeta" IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewPreview" IsLiveFilteringRequested="True"/>
        <CollectionViewSource x:Key="versionListViewImported" IsLiveFilteringRequested="True"/>

        <!-- Minecraft Style Green Button -->
        <Style x:Key="MinecraftButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3C8527"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#245415" BorderThickness="0,0,0,3" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4EA034"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2D661B"/>
                                <Setter TargetName="btnBorder" Property="BorderThickness" Value="0,3,0,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#38383D"/>
                                <Setter Property="Foreground" Value="#77777D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Dark Button Style -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B2B30"/>
            <Setter Property="Foreground" Value="#E0E0E6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#3D3D45" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3A3A42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#222226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Remove Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E2020"/>
            <Setter Property="Foreground" Value="#E57373"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="#522828" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#631B1B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#421313"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template for Version Not Installed -->
        <DataTemplate x:Key="templateVersionNotInstalled" DataType="{x:Type local:Version}">
            <Border Background="#1C1C20" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/bugrock_block.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayInstallStatus}" Foreground="#8A8A92" FontSize="12" Margin="24,4,0,0"/>
                    <Button x:Name="DownloadButton" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource DarkButtonStyle}" Content="Download" Command="{Binding DownloadCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" Padding="18,7"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for Version Installed -->
        <DataTemplate x:Key="templateVersionInstalled" DataType="{x:Type local:Version}">
            <Border Background="#1A221C" BorderBrush="#2C4430" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/bugrock_block.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#254228" CornerRadius="3" Margin="10,0,0,0" Padding="6,2">
                            <TextBlock Text="READY" Foreground="#52C41A" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DisplayInstallStatus}" Foreground="#79A882" FontSize="12" Margin="24,4,0,0"/>
                    <Button x:Name="RemoveButton" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource DangerButtonStyle}" Content="Remove" Command="{Binding RemoveCommand}" CommandParameter="{Binding}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Button x:Name="DownloadButton" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource MinecraftButtonStyle}" Content="PLAY" Command="{Binding LaunchCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" Padding="22,7"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for Version Downloading -->
        <DataTemplate x:Key="templateVersionDownloading" DataType="{x:Type local:Version}">
            <Border Background="#1C2128" BorderBrush="#283548" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                        <Image Source="Assets/bugrock_block.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                    </StackPanel>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding StateChangeInfo.DisplayStatus}" Foreground="#6CB6FF" FontSize="12" Margin="24,4,0,6"/>
                    <Canvas Name="progressSizeHack" Grid.Row="2" Grid.Column="0" Height="10" Margin="24,0,0,0">
                        <ProgressBar Width="{Binding Path=ActualWidth, ElementName=progressSizeHack, Mode=OneWay}" Height="{Binding Path=ActualHeight, ElementName=progressSizeHack, Mode=OneWay}" Minimum="0" Maximum="{Binding StateChangeInfo.MaxProgress}" Value="{Binding StateChangeInfo.Progress}" IsIndeterminate="{Binding StateChangeInfo.IsProgressIndeterminate}" Foreground="#107C41" Background="#262C38" BorderThickness="0"/>
                    </Canvas>
                    <Button Grid.Row="2" Grid.Column="1" Content="&#x2715;" Width="24" Height="24" Style="{StaticResource DangerButtonStyle}" Padding="0" Margin="10,0,0,0" Command="{Binding StateChangeInfo.CancelCommand}" IsEnabled="{Binding StateChangeInfo.HasCancelCommand}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Version List Template -->
        <ControlTemplate x:Key="templateVersionList" TargetType="ContentControl">
            <ListBox ItemsSource="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ContentControl x:Name="control" Content="{Binding}" ContentTemplate="{StaticResource templateVersionNotInstalled}"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter TargetName="control" Property="ContentTemplate" Value="{StaticResource templateVersionInstalled}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStateChanging}" Value="True">
                                <Setter TargetName="control" Property="ContentTemplate" Value="{StaticResource templateVersionDownloading}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ControlTemplate>
    </Window.Resources>

    <Grid Background="#141416">
        <Grid.RowDefinitions>
            <!-- Custom Top Bar / Menu -->
            <RowDefinition Height="38"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Menu Bar -->
        <Border Grid.Row="0" Background="#111113" BorderBrush="#222226" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,16,0">
                    <Image Source="Assets/bugrock_block.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="BUGrock Launcher" Foreground="#EEEEEE" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Menus: File, Tools, Options -->
                <Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Foreground="#CCCCCC">
                    <Menu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="Background" Value="#111113"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,4"/>
                        </Style>
                    </Menu.Resources>
                    <MenuItem Header="_File">
                        <MenuItem Header="Open log file" Click="MenuItemOpenLogFileClicked" />
                        <MenuItem Header="Open launcher data folder in Explorer" Click="MenuItemOpenDataDirClicked"/>
                        <Separator Background="#333336"/>
                        <MenuItem Header="_Import .appx or .msixvc..." Click="ImportButtonClicked" />
                    </MenuItem>
                    <MenuItem Header="_Tools">
                        <MenuItem Header="Uninstall all versions" Name="CleanupForMicrosoftStoreReinstall" Click="MenuItemUninstallAllVersionsClicked" />
                        <MenuItem Header="Cleanup for installing Minecraft from Microsoft Store" Name="CleanupForMicrosoftStoreInstall" Click="MenuItemCleanupForStoreInstallClicked" />
                        <MenuItem Header="Refresh version list" Name="RefreshVersionList" Click="MenuItemRefreshVersionListClicked" />
                        <MenuItem Header="Find my Minecraft data" Click="MenuItemFindMyDataClicked" />
                    </MenuItem>
                    <MenuItem Header="_Options">
                        <MenuItem Header="Delete installation packages after download to save space" IsCheckable="True" Name="DeleteAppxAfterDownloadOption" Checked="DeleteAppxAfterDownloadCheck_Changed" Unchecked="DeleteAppxAfterDownloadCheck_Changed" IsChecked="{Binding UserPrefs.DeleteAppxAfterDownload }" />
                        <MenuItem Header="Set version data endpoints..." Name="SetVersionListEndpoint" Click="MenuItemSetVersionListEndpointClicked" />
                        <MenuItem Header="Show legacy Beta versions tab" IsCheckable="True" Name="ShowBetaTabOption" Checked="ShowBetaTabOption_Changed" Unchecked="ShowBetaTabOption_Changed" IsChecked="{Binding UserPrefs.ShowLegacyBetaTab}" />
                    </MenuItem>
                </Menu>

                <!-- Right Window Status / Quick Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="Import Package" Click="ImportButtonClicked" Style="{StaticResource DarkButtonStyle}" Padding="10,4" Margin="0,0,8,0" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar + Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="230"/>
                <!-- Main View -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#131316" BorderBrush="#222226" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Account Profile Card -->
                    <Border Grid.Row="0" Margin="12,14,12,14" Background="#1C1C20" CornerRadius="6" Padding="10,8" BorderBrush="#292930" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Avatar / Cube Icon -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4" Background="#26262B" Margin="0,0,10,0">
                                <Image Source="Assets/bugrock_block.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Microsoft Account" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse Width="6" Height="6" Fill="#52C41A" Margin="0,0,5,0"/>
                                    <TextBlock Text="Active" Foreground="#52C41A" FontSize="11" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation Items List -->
                    <StackPanel Grid.Row="1" Margin="8,4,8,0">
                        <!-- Bedrock Edition (Active Tab) -->
                        <Border Background="#202026" CornerRadius="4" Margin="0,0,0,4">
                            <Grid Height="44">
                                <!-- Green active bar -->
                                <Border HorizontalAlignment="Left" Width="4" Background="#3C8527" CornerRadius="2,0,0,2"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Image Source="Assets/bugrock_block.png" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="MINECRAFT" Foreground="#AAAAAA" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Bedrock Edition" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Java Edition (Decorative) -->
                        <Border Background="Transparent" CornerRadius="4" Margin="0,0,0,4" Opacity="0.5">
                            <Grid Height="40">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="&#x25A3;" Foreground="#888888" FontSize="16" Margin="0,0,12,0"/>
                                    <TextBlock Text="Java Edition" Foreground="#888888" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Minecraft Dungeons (Decorative) -->
                        <Border Background="Transparent" CornerRadius="4" Margin="0,0,0,4" Opacity="0.5">
                            <Grid Height="40">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="&#x25C7;" Foreground="#888888" FontSize="16" Margin="0,0,12,0"/>
                                    <TextBlock Text="Minecraft Dungeons" Foreground="#888888" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Info / Quick Links -->
                    <Border Grid.Row="2" BorderBrush="#222226" BorderThickness="0,1,0,0" Padding="12,12">
                        <StackPanel>
                            <TextBlock Text="BUGrock Launcher" Foreground="#66666E" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Text="Multi-Version Bedrock Manager" Foreground="#55555C" FontSize="10" Margin="0,2,0,6"/>
                            <Button Content="Open Data Folder" Click="MenuItemOpenDataDirClicked" Style="{StaticResource DarkButtonStyle}" FontSize="11" Padding="6,4" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Top Navigation Tabs (Play | Installations | Patch Notes) -->
                    <RowDefinition Height="46"/>
                    <!-- Tab Content -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Tabs Bar -->
                <Border Grid.Row="0" Background="#161619" BorderBrush="#222226" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <RadioButton x:Name="TabNavPlay" Content="Play" IsChecked="True" Checked="TabNav_Checked" GroupName="MainViews" Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,20,0" Cursor="Hand" BorderThickness="0"/>
                        <RadioButton x:Name="TabNavInstallations" Content="Installations" Checked="TabNav_Checked" GroupName="MainViews" Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" Foreground="#8E8E93" FontWeight="Bold" FontSize="14" Margin="0,0,20,0" Cursor="Hand" BorderThickness="0"/>
                        <RadioButton x:Name="TabNavPatchNotes" Content="Patch Notes" Checked="TabNav_Checked" GroupName="MainViews" Style="{StaticResource {x:Type ToggleButton}}" Background="Transparent" Foreground="#8E8E93" FontWeight="Bold" FontSize="14" Margin="0,0,20,0" Cursor="Hand" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- View 1: PLAY VIEW -->
                <Grid x:Name="PlayViewGrid" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Hero Section -->
                        <RowDefinition Height="380"/>
                        <!-- News & Cards Section -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hero Banner -->
                    <Grid Grid.Row="0">
                        <!-- Hero Art Background Image -->
                        <Image Source="Assets/launcher_hero.png" Stretch="UniformToFill" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Dark Gradients overlay -->
                        <Grid>
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#55000000" Offset="0.0"/>
                                    <GradientStop Color="#00000000" Offset="0.3"/>
                                    <GradientStop Color="#CC141416" Offset="0.75"/>
                                    <GradientStop Color="#FF141416" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                        </Grid>

                        <!-- Hero Top Banner Logo -->
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,35,0,0">
                            <TextBlock Text="MINECRAFT" 
                                       Foreground="#EEEEEE" 
                                       FontSize="38" 
                                       FontWeight="Black" 
                                       FontFamily="Segoe UI Black, Impact" 
                                       HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="BUGROCK EDITION" 
                                       Foreground="#E056FD" 
                                       FontSize="15" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,4,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <!-- Hero Bottom Bar: Version Selector + Giant PLAY Button -->
                        <Border VerticalAlignment="Bottom" Background="#D9161619" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="6" Margin="24,0,24,16" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Version Selector -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="ACTIVE VERSION" Foreground="#8E8E93" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/bugrock_block.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="QuickPlayVersionLabel" Text="Switch to Installations tab to manage versions" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Giant PLAY Button -->
                                <Button Grid.Column="2" Click="QuickPlayButton_Click" Style="{StaticResource MinecraftButtonStyle}" Content="PLAY" FontSize="20" FontWeight="Black" Padding="48,14" VerticalAlignment="Center">
                                    <Button.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                                    </Button.Effect>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- News & Cards Section -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="24,12,24,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="WHAT'S NEW &amp; HIGHLIGHTS" Foreground="#AAAAAA" FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1 -->
                                <Border Grid.Column="0" Background="#1C1C20" BorderBrush="#2B2B32" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <Border Height="80" Background="#2A1B30" CornerRadius="4" Margin="0,0,0,10">
                                            <TextBlock Text="BUGrock Multi-Version" Foreground="#D100D1" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Run Any Bedrock Version" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="Install multiple versions of Minecraft side-by-side without uninstalling." Foreground="#8A8A94" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2 -->
                                <Border Grid.Column="2" Background="#1C1C20" BorderBrush="#2B2B32" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <Border Height="80" Background="#1B2B20" CornerRadius="4" Margin="0,0,0,10">
                                            <TextBlock Text="AppX &amp; MSIXVC Import" Foreground="#52C41A" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Full Custom Package Support" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="Import any downloaded .appx or .msixvc archive directly with one click." Foreground="#8A8A94" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3 -->
                                <Border Grid.Column="4" Background="#1C1C20" BorderBrush="#2B2B32" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <Border Height="80" Background="#1B2230" CornerRadius="4" Margin="0,0,0,10">
                                            <TextBlock Text="Safe Worlds &amp; Data" Foreground="#1890FF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Find &amp; Backup Your Worlds" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="Locate your world saves across Release and Preview versions with ease." Foreground="#8A8A94" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- View 2: INSTALLATIONS VIEW (Original MCLauncher Core Functionality) -->
                <Grid x:Name="InstallationsViewGrid" Grid.Row="1" Visibility="Collapsed" Margin="20,14,20,10">
                    <Grid.RowDefinitions>
                        <!-- Top Filters Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Version Tabs & List -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Controls Bar -->
                    <Border Grid.Row="0" Background="#18181C" BorderBrush="#26262C" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" Name="ShowInstalledVersionsOnlyCheckbox" Content="Show installed versions only" Checked="ShowInstalledVersionsOnlyCheckbox_Changed" Unchecked="ShowInstalledVersionsOnlyCheckbox_Changed" IsChecked="{Binding UserPrefs.ShowInstalledOnly}" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+ Import .appx or .msixvc..." Click="ImportButtonClicked" Style="{StaticResource MinecraftButtonStyle}" Padding="14,6" Margin="0,0,10,0" FontSize="12"/>
                                <Button Content="Refresh List" Click="MenuItemRefreshVersionListClicked" Style="{StaticResource DarkButtonStyle}" Padding="10,6" Margin="0,0,10,0" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Version Tabs Container -->
                    <TabControl x:Name="VersionTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="#8E8E93"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="16,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,8,6">
                                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="tabBorder" Property="BorderBrush" Value="#3C8527"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#CCCCCC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <TabItem Header="Release" x:Name="ReleaseTab">
                            <ContentControl x:Name="ReleaseVersionList" d:DataContext="{d:DesignData /SampleData/Versions.xaml}" Template="{StaticResource templateVersionList}" Margin="0,8,0,0"/>
                        </TabItem>
                        <TabItem Header="Beta" x:Name="BetaTab" Visibility="Collapsed">
                            <ContentControl x:Name="BetaVersionList" d:DataContext="{d:DesignData /SampleData/Versions.xaml}" Template="{StaticResource templateVersionList}" Margin="0,8,0,0"/>
                        </TabItem>
                        <TabItem Header="Preview" x:Name="PreviewTab">
                            <ContentControl x:Name="PreviewVersionList" d:DataContext="{d:DesignData /SampleData/Versions.xaml}" Template="{StaticResource templateVersionList}" Margin="0,8,0,0"/>
                        </TabItem>
                        <TabItem Header="Imported" x:Name="ImportedTab">
                            <ContentControl x:Name="ImportedVersionList" d:DataContext="{d:DesignData /SampleData/Versions.xaml}" Template="{StaticResource templateVersionList}" Margin="0,8,0,0"/>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- View 3: PATCH NOTES VIEW -->
                <Grid x:Name="PatchNotesViewGrid" Grid.Row="1" Visibility="Collapsed" Margin="24,16,24,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="MINECRAFT BEDROCK PATCH NOTES" Foreground="#FFFFFF" FontSize="18" FontWeight="Black" Margin="0,0,0,16"/>

                            <Border Background="#1C1C20" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="BUGrock Launcher - Multi-Version Manager Ready" Foreground="#52C41A" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Released with full GDK and UWP support for Windows 10 &amp; 11." Foreground="#8A8A94" FontSize="12" Margin="0,2,0,10"/>
                                    <TextBlock Text="• Integrated side-by-side installations of Releases, Previews, Betas, and Imported packages.&#x0a;• Full official UI experience with instant Play button.&#x0a;• Direct download from official Microsoft Store CDN Delivery endpoints." Foreground="#CCCCCC" FontSize="13" LineHeight="20"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1C1C20" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Minecraft: Bedrock Edition - Latest Major Update" Foreground="#1890FF" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="Tricky Trials &amp; Bundles Update" Foreground="#8A8A94" FontSize="12" Margin="0,2,0,10"/>
                                    <TextBlock Text="• Trial Chambers, Breeze, Mace weapon, and ominous events.&#x0a;• Hardcore mode in Bedrock Edition.&#x0a;• Bundles of Bravery and UI upgrades." Foreground="#CCCCCC" FontSize="13" LineHeight="20"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Bottom Status Indicator (Loading progress from original launcher) -->
                <Border Grid.Row="2" Background="#111113" BorderBrush="#202024" BorderThickness="0,1,0,0" Padding="16,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Status: " Foreground="#66666E" FontSize="11"/>
                            <TextBlock Text="Ready" Foreground="#52C41A" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Original LoadingProgressGrid -->
                        <Grid Name="LoadingProgressGrid" Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Name="LoadingProgressLabel" Content="Nothing" Foreground="#AAAAAA" FontSize="11" Padding="0,0,0,0" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Name="LoadingProgressBar" Width="100" Height="6" Margin="8,0,0,0" Maximum="5" Value="4" Background="#26262B" Foreground="#3C8527" BorderThickness="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
