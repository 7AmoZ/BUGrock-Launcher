<Window x:Class="MCLauncher.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BUGrock Launcher" 
        Height="540" Width="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/bugrock.ico">

    <Window.Resources>
        <!-- Fade in animation -->
        <Storyboard x:Key="PulseStoryBoard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BlockImage" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0.8" To="1.0" Duration="0:0:1.5" />
            <DoubleAnimation Storyboard.TargetName="GlowEllipse" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0.2" To="0.5" Duration="0:0:1.5" />
        </Storyboard>
    </Window.Resources>

    <Border Background="#121214" CornerRadius="8" BorderBrush="#28282B" BorderThickness="1" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <!-- Top custom title bar -->
            <Grid VerticalAlignment="Top" Height="36" Margin="12,4,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/bugrock_block.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="BUGrock Launcher" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2014;" Click="MinimizeButton_Click" Background="Transparent" Foreground="#888888" BorderThickness="0" Width="30" Height="26" Cursor="Hand" FontSize="10">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#333336"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#x2715;" Click="CloseButton_Click" Background="Transparent" Foreground="#888888" BorderThickness="0" Width="30" Height="26" Cursor="Hand" FontSize="11" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Center Content -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Launcher Title -->
                <TextBlock Text="BUGrock Launcher" 
                           Foreground="#FFFFFF" 
                           FontSize="34" 
                           FontWeight="Black" 
                           FontFamily="Segoe UI Black, Impact, Arial Black" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,24">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF00FF" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Centered Block with Glow -->
                <Grid Width="220" Height="220" HorizontalAlignment="Center">
                    <Ellipse x:Name="GlowEllipse" Fill="#D100D1" Opacity="0.3" Width="200" Height="200">
                        <Ellipse.Effect>
                            <BlurEffect Radius="60"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    
                    <Image x:Name="BlockImage" 
                           Source="Assets/bugrock_block.png" 
                           Width="180" Height="180" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                        <Image.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.6"/>
                        </Image.Effect>
                    </Image>
                </Grid>
                
                <TextBlock Text="Windows 10/11 Edition Multi-Version Manager" 
                           Foreground="#8E8E93" 
                           FontSize="13" 
                           FontWeight="Medium" 
                           HorizontalAlignment="Center" 
                           Margin="0,18,0,0"/>
            </StackPanel>

            <!-- Bottom Status (Loading / Signing in...) -->
            <Grid VerticalAlignment="Bottom" Margin="24,0,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Loading versions..." Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- Animated loading ring / progress dots -->
                    <ProgressBar x:Name="LoadingSpinner" IsIndeterminate="True" Width="80" Height="4" Background="#222224" Foreground="#107C41" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
