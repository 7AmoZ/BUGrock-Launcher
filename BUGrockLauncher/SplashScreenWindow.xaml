<Window x:Class="BUGrockLauncher.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BUGrock Launcher" 
        Height="540" Width="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="Assets/bugrock.ico">

    <Window.Resources>
        <!-- Fade in animation -->
        <Storyboard x:Key="PulseStoryBoard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="EmblemImage" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0.88" To="1.0" Duration="0:0:1.5" />
        </Storyboard>
    </Window.Resources>

    <Border Background="#121214" CornerRadius="8" BorderBrush="#28282B" BorderThickness="1" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <!-- Top custom title bar -->
            <Grid VerticalAlignment="Top" Height="36" Margin="12,4,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/bugrock_splash_emblem.png" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="BUGrock Launcher" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="&#x2014;" Click="MinimizeButton_Click" Background="Transparent" Foreground="#888888" BorderThickness="0" Width="30" Height="26" Cursor="Hand" FontSize="10">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#333336"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#x2715;" Click="CloseButton_Click" Background="Transparent" Foreground="#888888" BorderThickness="0" Width="30" Height="26" Cursor="Hand" FontSize="11" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Center Content: High-Res 3D Emblem with Glowing Outline -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="EmblemImage" 
                       Source="Assets/bugrock_splash_emblem.png" 
                       Width="330" Height="330" 
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                    <Image.Effect>
                        <DropShadowEffect Color="#C026D3" BlurRadius="40" ShadowDepth="0" Opacity="0.45"/>
                    </Image.Effect>
                </Image>
            </Grid>

            <!-- Bottom Status (Loading / Signing in...) -->
            <Grid VerticalAlignment="Bottom" Margin="24,0,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Loading versions..." Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- Animated loading ring / progress dots -->
                    <ProgressBar x:Name="LoadingSpinner" IsIndeterminate="True" Width="80" Height="4" Background="#222224" Foreground="#107C41" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
