<Window x:Class="BUGrockLauncher.WorldConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="World Storage Notice"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Button Styles -->
        <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#48BB78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2F855A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E202A"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#2F3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#282A38"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#D05CE3"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#171822"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E92A4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E53E3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="#13141A" BorderBrush="#D05CE3" BorderThickness="1.5" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.85"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Content Body -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Border Grid.Row="0" Background="#181921" CornerRadius="10,10,0,0" Padding="16,12" MouseDown="Header_MouseDown" Cursor="SizeAll">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon Badge -->
                        <Border Grid.Column="0" Width="32" Height="32" Background="#2B1530" BorderBrush="#D05CE3" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="🗺️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title and Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="World Storage Notice" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="Multiple world save locations detected" Foreground="#8E92A4" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Style="{StaticResource DialogCloseButtonStyle}" Content="&#x2715;" Click="CloseButton_Click" ToolTip="Close"/>
                    </Grid>
                </Border>

                <!-- Body Content -->
                <StackPanel Grid.Row="1" Margin="20,16,20,16">
                    <TextBlock Text="We detected saved worlds in more than one folder on your PC. To prevent overwriting your existing saves, this version will use its own folder." Foreground="#E2E8F0" FontSize="13" TextWrapping="Wrap" LineHeight="18"/>

                    <TextBlock Text="DETECTED WORLD LOCATIONS" Foreground="#8E92A4" FontSize="11" FontWeight="Bold" Margin="0,16,0,8"/>

                    <!-- List of world locations -->
                    <ItemsControl x:Name="LocationsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181921" BorderBrush="#252736" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Profile / Location Icon -->
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>

                                        <!-- Title and Path -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FriendlyName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding PathDisplay}" Foreground="#718096" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding FullPath}"/>
                                        </StackPanel>

                                        <!-- World Count Badge -->
                                        <Border Grid.Column="2" Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WorldCountText}" Foreground="{Binding BadgeForeground}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Safe Notice Box -->
                    <Border Background="#1C1826" BorderBrush="#552B5F" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="💡" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="Your existing worlds remain completely safe and untouched. You can continue and launch now, or open the folder anytime to copy worlds between versions." Foreground="#D1D5DB" FontSize="11.5" TextWrapping="Wrap" LineHeight="16"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Footer Action Buttons -->
                <Border Grid.Row="2" Background="#111218" BorderBrush="#1F202B" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Open Folder Button -->
                        <Button Grid.Column="0" Click="OpenFolderButton_Click" Style="{StaticResource DialogSecondaryButtonStyle}" Content="📂 Open Worlds Folder" ToolTip="Open the worlds directory in Windows Explorer"/>

                        <!-- Cancel Button -->
                        <Button Grid.Column="2" Click="CancelButton_Click" Style="{StaticResource DialogSecondaryButtonStyle}" Content="Cancel" Margin="0,0,10,0" IsCancel="True"/>

                        <!-- Play Anyway Button -->
                        <Button Grid.Column="3" Click="PlayAnywayButton_Click" Style="{StaticResource DialogPrimaryButtonStyle}" Content="▶ PLAY ANYWAY" IsDefault="True"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
