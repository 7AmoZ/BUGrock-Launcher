<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <AssemblyName>BUGrock_Launcher</AssemblyName>
    <RootNamespace>BUGrockLauncher</RootNamespace>
    <ApplicationIcon>Assets\bugrock.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BaseOutputPath>$(SolutionDir)$(Platform)\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Optional: also stop configuration folder -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="..\GDKDecryptHelper\GDKDecryptHelper.vcxproj" />
    <ProjectReference Include="..\GDKLaunchShim\GDKLaunchShim.vcxproj" />
    <ProjectReference Include="..\WUTokenHelper\WUTokenHelper.vcxproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\*.jpg" />
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

</Project>
