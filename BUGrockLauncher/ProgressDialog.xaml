<Window x:Class="BUGrockLauncher.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cleanup for Microsoft Store install"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Border Background="#13141A" BorderBrush="#D05CE3" BorderThickness="1.5" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.85"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="#181921" CornerRadius="10,10,0,0" Padding="16,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧹" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="System Cleanup" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="20,18,20,20">
                    <TextBlock Text="Cleaning up system for installing Minecraft from Microsoft Store..." Foreground="#E2E8F0" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- Thin Magenta Indeterminate Progress Bar -->
                    <Border Background="#181921" CornerRadius="3" Height="6" SnapsToDevicePixels="True">
                        <ProgressBar Name="progressBar" Height="6" Background="Transparent" Foreground="#D05CE3" BorderThickness="0" IsIndeterminate="True"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
